@model IEnumerable<HastaneRandevu.Models.Appointment>

@{
    ViewData["Title"] = "Günlük Plan";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">Hastalarım ve Randevular</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">Bugün için hiç randevunuz bulunmamaktadır.</div>
    }
    else
    {
        <table class="table table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Tarih</th>
                    <th>Hasta Adı</th>
                    <th>Kan Grubu</th>
                    <th>Şikayet</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Patient.FullName</td>
                        <td><span class="badge bg-danger">@item.Patient.BloodType</span></td>
                        <td>@item.Complaint</td>
                        <td>
                            <a href="/Patient/History?patientId=@item.PatientID" class="btn btn-sm btn-outline-info">Geçmişi Gör</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a href="/Clinic" class="btn btn-secondary mt-3">Kliniklere Dön</a>
</div>